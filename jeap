#!/usr/bin/env bash
# jEAP CLI launcher: downloads and updates the native jEAP CLI binary, points it to the system Java truststore
# and runs it. Compatible with bash 3.2 (default bash on macOS).
set -eo pipefail

REPO_URL="https://github.com/jeap-admin-ch/jeap-cli"
JEAP_DIR="$HOME/.jeap"
BIN_DIR="$JEAP_DIR/bin"
MANAGED_BINARY="$BIN_DIR/jeap-cli"
VERSION_FILE="$BIN_DIR/.version"
MARKER_FILE="$JEAP_DIR/.cli-update"  # Update marker file
CHECK_WINDOW_SEC=$((24*60*60))       # 1 day in seconds

die() {
  echo "Error: $*" >&2
  exit 1
}

warn() {
  echo "Warning: $*" >&2
}

verbose() {
  if [[ -n "${JEAP_CLI_VERBOSE:-}" ]]; then
    echo "[INFO] $*" >&2
  fi
}

# Cross-platform mtime helper for Linux (GNU stat) and macOS (BSD stat)
get_file_mtime() {
  local file="$1"

  # Detect OS once and use the right stat variant
  case "$(uname)" in
    Darwin)
      # macOS / BSD stat: %m = epoch modification time
      stat -f %m "$file"
      ;;
    *)
      # Linux / GNU stat: %Y = epoch modification time
      stat -c %Y "$file"
      ;;
  esac
}

detect_platform() {
  case "$(uname -s)/$(uname -m)" in
    Linux/x86_64) PLATFORM="linux-x86_64" ;;
    Darwin/arm64) PLATFORM="macos-aarch64" ;;
    *) die "Unsupported platform: $(uname -s) $(uname -m). The jEAP CLI supports Linux x86_64 and macOS arm64. On Windows, use WSL with the Linux binary." ;;
  esac
}

update_check_due() {
  [[ ! -f "$MARKER_FILE" ]] && return 0
  local now last
  now=$(date +%s)
  last=$(get_file_mtime "$MARKER_FILE") || return 0
  (( now - last >= CHECK_WINDOW_SEC ))
}

# Resolves the latest release version from the redirect of /releases/latest (no GitHub API rate limit).
latest_version() {
  local url version
  url=$(curl -fsSLI --connect-timeout 10 -o /dev/null -w '%{url_effective}' "$REPO_URL/releases/latest") || return 1
  case "$url" in
    */releases/tag/*) version="${url##*/releases/tag/}" ;;
    *) return 1 ;;
  esac
  [[ "$version" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
  echo "$version"
}

verify_checksum() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum -c "$1"
  else
    shasum -a 256 -c "$1"
  fi
}

# Downloads the binary of the given release into the managed location. Returns non-zero on failure.
download_binary() {
  local version="$1"
  local asset="jeap-cli-$PLATFORM"
  local url="$REPO_URL/releases/download/$version/$asset"
  local tmp_dir status

  mkdir -p "$BIN_DIR" && tmp_dir=$(mktemp -d "$BIN_DIR/.download.XXXXXX") || return 1
  echo "Downloading jEAP CLI $version for $PLATFORM ..." >&2
  status=$(curl -sSL --connect-timeout 10 -o "$tmp_dir/$asset" -w '%{http_code}' "$url") || status="failed"
  if [[ "$status" == "200" ]]; then
    status=$(curl -sSL --connect-timeout 10 -o "$tmp_dir/$asset.sha256" -w '%{http_code}' "$url.sha256") || status="failed"
  fi
  if [[ "$status" == "404" ]]; then
    warn "Release $version has no jEAP CLI binary for $PLATFORM. Native binaries are published from version 2.0.0 on."
  elif [[ "$status" != "200" ]]; then
    warn "Download of $url failed (status: $status)."
  elif ! (cd "$tmp_dir" && verify_checksum "$asset.sha256") >/dev/null 2>&1; then
    warn "Checksum verification of the jEAP CLI $version download failed."
  elif chmod +x "$tmp_dir/$asset" && mv -f "$tmp_dir/$asset" "$MANAGED_BINARY" && echo "$version" > "$VERSION_FILE"; then
    rm -rf "$tmp_dir"
    return 0
  fi
  rm -rf "$tmp_dir"
  return 1
}

# Ensures the managed binary is installed and up to date, sets VERSION.
ensure_managed_binary() {
  local wanted="" checked=false
  detect_platform
  VERSION=$(cat "$VERSION_FILE" 2>/dev/null || true)
  [[ -x "$MANAGED_BINARY" ]] || VERSION=""

  if [[ -n "${JEAP_CLI_VERSION:-}" ]]; then
    wanted="$JEAP_CLI_VERSION"
  elif [[ -z "$VERSION" ]] || update_check_due; then
    if wanted=$(latest_version); then
      checked=true
    elif [[ -n "$VERSION" ]]; then
      warn "Could not check for a new jEAP CLI release. Continuing with the installed version $VERSION."
    else
      die "Could not determine the latest jEAP CLI release from $REPO_URL/releases/latest. Check your network and proxy settings."
    fi
  fi

  if [[ -n "$wanted" && "$wanted" != "$VERSION" ]]; then
    if download_binary "$wanted"; then
      VERSION="$wanted"
    elif [[ -n "$VERSION" ]]; then
      warn "Continuing with the installed jEAP CLI $VERSION."
      checked=false
    else
      die "The jEAP CLI binary could not be installed."
    fi
  fi

  if $checked; then
    touch "$MARKER_FILE"
  fi
}

# Selects the truststore passed to the binary. A native image does not read the OS trust store by itself.
# Never pass trustStoreType/Provider/Password: without a readable trustStore file the binary fails with them.
resolve_truststore() {
  TRUSTSTORE=""
  if [[ -n "${JEAP_CLI_TRUSTSTORE:-}" ]]; then
    [[ -f "$JEAP_CLI_TRUSTSTORE" && -r "$JEAP_CLI_TRUSTSTORE" ]] || die "JEAP_CLI_TRUSTSTORE is not a readable file: $JEAP_CLI_TRUSTSTORE"
    TRUSTSTORE="$JEAP_CLI_TRUSTSTORE"
    return
  fi
  local candidates=(/etc/ssl/certs/java/cacerts /etc/pki/ca-trust/extracted/java/cacerts)
  local candidate mac_java_home
  if [[ -n "${JAVA_HOME:-}" ]]; then
    candidates+=("$JAVA_HOME/lib/security/cacerts")
  fi
  if [[ "$(uname -s)" == "Darwin" ]]; then
    mac_java_home=$(/usr/libexec/java_home 2>/dev/null || true)
    if [[ -n "$mac_java_home" ]]; then
      candidates+=("$mac_java_home/lib/security/cacerts")
    fi
  fi
  for candidate in "${candidates[@]}"; do
    if [[ -f "$candidate" && -r "$candidate" ]]; then
      TRUSTSTORE="$candidate"
      return
    fi
  done
}

# Auto-refresh AWS CodeArtifact npm token if expired
refresh_codeartifact_npm_token() {
  local npmrc="$HOME/.npmrc"
  [[ -f "$npmrc" ]] || return 0

  # Check if .npmrc references AWS CodeArtifact
  local registry_url
  registry_url=$(grep -oP '(?<=registry=)https://[^\s]+\.d\.codeartifact\.[^\s]+\.amazonaws\.com/npm/[^\s]+/' "$npmrc" 2>/dev/null | head -1 || true)
  [[ -n "$registry_url" ]] || return 0

  # Parse: https://<domain>-<owner>.d.codeartifact.<region>.amazonaws.com/npm/<repo>/
  local host repo domain_dash_owner region domain owner
  host=$(echo "$registry_url" | sed 's|https://||;s|/.*||')
  repo=$(echo "$registry_url" | grep -oP '/npm/\K[^/]+' || true)
  domain_dash_owner=$(echo "$host" | cut -d. -f1)
  region=$(echo "$host" | grep -oP '\.d\.codeartifact\.\K[^.]+(?=\.amazonaws\.com)' || true)
  owner=$(echo "$domain_dash_owner" | grep -oP '\d+$' || true)
  # shellcheck disable=SC2001
  domain=$(echo "$domain_dash_owner" | sed "s/-${owner}$//")

  [[ -n "$domain" && -n "$owner" && -n "$region" && -n "$repo" ]] || return 0

  # Find the auth token in .npmrc
  local token
  token=$(grep -oP "(?<=//${host}/npm/${repo}/:_authToken=)\S+" "$npmrc" 2>/dev/null | head -1 || true)
  [[ -n "$token" ]] || return 0

  # Decode the JWE/JWT header (first base64url segment) to get "exp"
  local header_b64 exp now
  header_b64="${token%%.*}"
  exp=$(echo "$header_b64" | python3 -c "
import base64, json, sys
h = sys.stdin.read().strip().replace('-', '+').replace('_', '/')
h += '=' * (4 - len(h) % 4)
try:
    d = json.loads(base64.b64decode(h))
    print(d.get('exp', 0))
except Exception:
    print(0)
" 2>/dev/null || echo 0)
  now=$(date +%s)

  if [[ -n "$exp" && "$exp" -gt 0 && "$exp" -le "$now" ]]; then
    echo "⚠️  AWS CodeArtifact npm token expired. Attempting to refresh..."
    if command -v aws &>/dev/null; then
      if aws codeartifact login --tool npm \
           --domain "$domain" --domain-owner "$owner" \
           --region "$region" --repository "$repo" 2>&1; then
        echo "✅ AWS CodeArtifact npm token refreshed."
      else
        echo "⚠️  Failed to refresh token. npm builds may fail with E401."
        echo "    Run manually: aws codeartifact login --tool npm --domain $domain --domain-owner $owner --region $region --repository $repo"
      fi
    else
      echo "⚠️  'aws' CLI not found. Cannot auto-refresh CodeArtifact token."
      echo "    Run manually: aws codeartifact login --tool npm --domain $domain --domain-owner $owner --region $region --repository $repo"
    fi
  fi
}

# Formats the command line for logging with access tokens redacted
format_command() {
  local arg redact_next=false
  for arg in "$@"; do
    if $redact_next; then
      printf '[REDACTED] '
      redact_next=false
    elif [[ "$arg" == --access-token=* ]]; then
      printf -- '--access-token=[REDACTED] '
    else
      [[ "$arg" == "--access-token" ]] && redact_next=true
      printf '%q ' "$arg"
    fi
  done
}

mkdir -p "$JEAP_DIR"

if [[ -n "${JEAP_CLI_BINARY:-}" ]]; then
  [[ -f "$JEAP_CLI_BINARY" && -x "$JEAP_CLI_BINARY" ]] || die "JEAP_CLI_BINARY is not an executable file: $JEAP_CLI_BINARY"
  BINARY="$JEAP_CLI_BINARY"
  PLATFORM="n/a"
  VERSION="local binary"
else
  ensure_managed_binary
  BINARY="$MANAGED_BINARY"
fi

resolve_truststore
JAVA_OPTS_ARGS=()
if [[ -n "$TRUSTSTORE" ]]; then
  JAVA_OPTS_ARGS+=("-Djavax.net.ssl.trustStore=$TRUSTSTORE")
fi

refresh_codeartifact_npm_token

if [[ -n "${JEAP_CLI_VERBOSE:-}" ]]; then
  verbose "Platform: $PLATFORM"
  verbose "Binary: $BINARY ($VERSION)"
  verbose "Truststore: ${TRUSTSTORE:-<embedded>}"
  verbose "Command: $(format_command "$BINARY" ${JAVA_OPTS_ARGS[@]+"${JAVA_OPTS_ARGS[@]}"} "$@")"
fi

exec "$BINARY" ${JAVA_OPTS_ARGS[@]+"${JAVA_OPTS_ARGS[@]}"} "$@"
